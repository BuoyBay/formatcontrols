{
  "schema": "buoy.designer.plugin",
  "schemaVersion": 1,
  "package": {
    "name": "formatcontrols",
    "version": "0.1.0",
    "provenance": "Buoy FormatControls"
  },
  "controls": [
    {
      "typeName": "formatcontrols.MaskedTextField",
      "sourceTypeName": "MaskedTextField",
      "sourceImport": "formatcontrols.FormatDesigner",
      "displayName": "Masked text field",
      "category": "Text input",
      "description": "Native text field with strict commit-time MaskKit validation",
      "defaultWidth": 260,
      "defaultHeight": 30,
      "properties": [
        {
          "name": "MaskPattern",
          "kind": "string",
          "defaultExpression": "\"\"",
          "category": "Input mask",
          "metadata": {
            "studioEditorId": "formatcontrols.mask-pattern.v1"
          }
        },
        {
          "name": "RawInput",
          "kind": "boolean",
          "defaultExpression": "True",
          "category": "Input mask"
        },
        {
          "name": "AllowsEmpty",
          "kind": "boolean",
          "defaultExpression": "True",
          "category": "Input mask"
        },
        {
          "name": "Value",
          "kind": "string",
          "defaultExpression": "\"\"",
          "category": "Input mask",
          "displayName": "Value (raw characters)",
          "metadata": {
            "studioEditorId": "formatcontrols.mask-value.v1"
          }
        },
        {
          "name": "Placeholder",
          "kind": "string",
          "defaultExpression": "\"\"",
          "category": "Text"
        },
        {
          "name": "IsReadOnly",
          "kind": "boolean",
          "defaultExpression": "False",
          "category": "Text"
        }
      ],
      "renderer": {
        "version": 1,
        "steps": [
          {
            "op": "fillRoundedRect",
            "radius": 4,
            "color": [
              1,
              1,
              1
            ],
            "darkColor": [
              0.15,
              0.17,
              0.2
            ]
          },
          {
            "op": "strokeRoundedRect",
            "radius": 4,
            "lineWidth": 1,
            "color": [
              0.45,
              0.5,
              0.58
            ]
          },
          {
            "op": "text",
            "x": 8,
            "y": 20,
            "size": 13,
            "color": [
              0.2,
              0.25,
              0.32
            ],
            "darkColor": [
              0.82,
              0.86,
              0.92
            ],
            "property": "MaskPattern",
            "prefix": "Mask: "
          }
        ]
      },
      "icon": {
        "version": 1,
        "steps": [
          {
            "op": "strokeRoundedRect",
            "x": 1,
            "y": 5,
            "width": 22,
            "height": 14,
            "radius": 3,
            "lineWidth": 1,
            "color": [
              0.3,
              0.5,
              0.7
            ]
          },
          {
            "op": "text",
            "x": 4,
            "y": 16,
            "size": 11,
            "color": [
              0.3,
              0.5,
              0.7
            ],
            "prefix": "##"
          }
        ]
      }
    }
  ]
}
